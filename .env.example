# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# Postgres database (Neon from the Vercel Marketplace works). The bookings table is created automatically.
DATABASE_URL=

# Square: developer.squareup.com > your app. Use sandbox keys first, then production.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Email through Resend (resend.com). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Delish Town Car <bookings@example.com>"

# Text messages through Twilio (twilio.com). Leave blank until US texting registration is approved.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Live chat bubble (tawk.to). From the dashboard: Administration > Chat Widget, embed link
# https://embed.tawk.to/<property id>/<widget id>. Leave blank to hide the chat.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# Who gets the new-booking alerts. Defaults to delish86@gmail.com and (202) 409-9469.
OWNER_EMAIL=
OWNER_PHONE=

# Public site address, used in links inside emails and texts, e.g. https://delishtowncar.com
SITE_URL=
